# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python tools
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log

# Build
build/
dist/
*.egg-info/

# Coverage
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Jupyter
.ipynb_checkpoints/

# Databases
*.sqlite
*.sqlite3

# Large ML files
*.pt
*.pth
*.onnx
*.h5
*.pkl

# Temporary files
*.tmp
*.temp